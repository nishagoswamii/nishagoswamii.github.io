---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import { Navbar } from '@/components/Navbar';
import Footer from '@/components/Footer';
import Sticker from '@/components/Sticker';
import StickerTitle from '@/components/StickerTitle';
import { projects } from '@/data/portfolioData';

const posts = (await getCollection('blog', ({ data }) => !data.draft)).map(post => ({ title: post.data.title, slug: post.slug }));
const searchProjects = projects.map(p => ({ id: p.id, title: p.title, githubUrl: p.githubUrl }));
---

<Layout title="Page not found | Nisha Goswami">
    <Navbar client:load posts={posts} projects={searchProjects} />
    <main class="relative z-10">
       <section class="book-section sheet-paper page-top">
          <StickerTitle text="Oops!" as="h1" />
          <div class="section-sticker"><Sticker mood="wow" react="laugh" /></div>
          <p class="lost-text">This page doesn't exist. It may have moved, or the link has a typo.</p>
          <a class="shelf-link lost-link" href="/">Back home →</a>
       </section>
    </main>
    <Footer />
</Layout>
